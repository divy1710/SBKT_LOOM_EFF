# Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# Application environment: development | production | test
NODE_ENV=development

# Port the backend server listens on
PORT=5000

# Allowed client origin for CORS (must match your frontend URL exactly)
CLIENT_URL=http://localhost:5173

# MongoDB connection URI
# For local development: mongodb://127.0.0.1:27017/sbkt_loom
# For Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sbkt_loom
MONGODB_URI=mongodb://127.0.0.1:27017/sbkt_loom

# ─── Phase 2: Authentication ─────────────────────────────────────────────────

# JWT signing secret — must be at least 32 random characters
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_characters_here

# Access token lifespan (examples: 15m, 1h, 8h)
JWT_EXPIRES_IN=15m

# Cookie signing secret — must be at least 32 random characters (different from JWT_SECRET)
COOKIE_SECRET=replace_with_another_long_random_secret_minimum_32_chars

# ─── Phase 2: Bootstrap (DISABLED by default) ────────────────────────────────
# Set BOOTSTRAP_ENABLED=true only to create the very first SUPER_ADMIN.
# Set it back to false (or remove it) after the first admin is created.
# NEVER leave bootstrap enabled in production.
BOOTSTRAP_ENABLED=false

# Required only when BOOTSTRAP_ENABLED=true — use a different secret from JWT_SECRET
# BOOTSTRAP_SECRET=replace_with_a_long_random_bootstrap_secret_here
